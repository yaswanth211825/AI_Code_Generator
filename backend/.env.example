# Copy to .env (or export these in your shell / hosting provider's dashboard) and fill in real values.
# None of these have real values here - this file is safe to commit.

# Postgres (with pgvector extension enabled)
DB_URL=jdbc:postgresql://localhost:9010/pgvector-test
DB_USERNAME=user
DB_PASSWORD=password

# JWT signing secret - generate a long random string for production
JWT_SECRET_KEY=change-me-to-a-long-random-string

# S3-compatible object storage (MinIO locally, or Supabase/R2/etc in production)
# IMPORTANT: two buckets must exist before project creation will work:
#   - "projects" (or whatever STORAGE_PROJECT_BUCKET is set to) - where generated files are saved
#   - "starter-projects" - must contain the contents of ./starter-template/react-vite-tailwind-daisyui-starter/
#     uploaded under the key prefix "react-vite-tailwind-daisyui-starter/"
# Neither bucket is created automatically. See starter-template/README.md for upload instructions.
STORAGE_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_PROJECT_BUCKET=projects

# LLM provider - OpenRouter by default (NOT a direct Google/OpenAI key - see below).
# Requires credit on your OpenRouter account: this app's system prompt uses
# structured multi-turn tool-calling that free-tier models don't follow reliably
# (tested: slow, and prone to malformed tool calls that hard-fail the request).
# openrouter/free works as a zero-cost fallback for simple chat but is not
# reliable for the code-generation flow.
#
# Tested and NOT usable as a drop-in replacement: a direct Gemini API key
# (generativelanguage.googleapis.com). Gemini 3.x models require echoing a
# "thought_signature" on multi-turn tool-call follow-ups, which this Spring AI
# version's generic OpenAI-compatible client doesn't send - every file-edit
# request fails with a 400 "Function call is missing a thought_signature" error.
# OpenRouter's gateway handles this internally, which is why it's the default.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api
AI_MODEL=google/gemini-3-flash-preview

# Stripe (optional - leave blank to disable billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

CLIENT_URL=http://localhost:8080
