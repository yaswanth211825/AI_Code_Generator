# Copy to .env (or export these in your shell / hosting provider's dashboard) and fill in real values.
# None of these have real values here - this file is safe to commit.

# Postgres (with pgvector extension enabled)
DB_URL=jdbc:postgresql://localhost:9010/pgvector-test
DB_USERNAME=user
DB_PASSWORD=password

# JWT signing secret - generate a long random string for production
JWT_SECRET_KEY=change-me-to-a-long-random-string

# S3-compatible object storage (MinIO locally, or Supabase/R2/etc in production)
# IMPORTANT: two buckets must exist before project creation will work:
#   - "projects" (or whatever STORAGE_PROJECT_BUCKET is set to) - where generated files are saved
#   - "starter-projects" - must contain the contents of ./starter-template/react-vite-tailwind-daisyui-starter/
#     uploaded under the key prefix "react-vite-tailwind-daisyui-starter/"
# Neither bucket is created automatically. See starter-template/README.md for upload instructions.
STORAGE_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_PROJECT_BUCKET=projects

# LLM provider (OpenRouter by default)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
AI_MODEL=google/gemini-3-flash-preview

# Stripe (optional - leave blank to disable billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

CLIENT_URL=http://localhost:8080
